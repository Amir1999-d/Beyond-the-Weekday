# ---------------------------------------------------------------------------
# Input data. Nothing under data/ is published except its README, the
# checksum manifest and the OpenStreetMap service snapshot (ODbL).
# GTFS, ISTAT and operator files are obtained separately: see data/README.md.
# ---------------------------------------------------------------------------
/data/*
!/data/README.md
!/data/MANIFEST.sha256
!/data/osm_services_2026-07-05.gpkg

# Operator (ATM) files must never be committed, wherever they are placed.
*.xlsx
*.xls
*Tornellati*
*Tesista*

# Generated outputs (including robustness_output.txt written by the notebook)
/outputs/
robustness_output.txt

# Python / notebook state
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
